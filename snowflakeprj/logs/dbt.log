create or replace   view FIL_DB.FIL_SCHEMA.customerquery
  
   as (
    SELECT 
    c.customerName, 
    c.phone, 
    c.city, 
    c.state, 
    c.country, 
    o.orderDate, 
    o.status, 
    p.productName, 
    od.quantityOrdered
